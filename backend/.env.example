# ---- Server ----
PORT=3100
HOST=127.0.0.1
# Comma-separated list; leave empty when frontend and API are on the same domain (recommended)
CORS_ORIGIN=

# ---- Database (either DATABASE_URL or the DB_* values) ----
# DATABASE_URL=postgres://vivo:password@localhost:5432/vivo_diwali
DB_HOST=localhost
DB_PORT=5432
DB_USER=vivo
DB_PASSWORD=change-me
DB_NAME=vivo_diwali
DB_SYNC=true
DB_SSL=false

# ---- Admin login ----
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- Contest rules ----
MIN_PRICE=20000
# block  = IMEI not in uploaded list is rejected on the form
# review = entry is saved with status "review" for the vivo team to check
IMEI_MISMATCH_MODE=block
# Optional open/close times (ISO, IST offset). Leave empty to keep the contest always open.
CONTEST_START=
CONTEST_END=
